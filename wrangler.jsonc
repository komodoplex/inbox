{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "komodoplex-messages",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "komodoplex-messages-db",
      "database_id": "YOUR_D1_DATABASE_ID_HERE",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
